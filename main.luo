local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "❄️ FrostHub | Steal a Brainrot",
   LoadingTitle = "FrostHub Loading...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {
      Enabled = false
   }
})

local InfinityJumpEnabled = false
local AutoGrabEnabled = false
local SpeedBoostEnabled = false
local WalkSpeedValue = 50

-- Auto Grab
task.spawn(function()
    while task.wait(0.1) do
        if AutoGrabEnabled then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("TouchTransmitter") and obj.Parent:FindFirstChild("Handle") then
                    firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, obj.Parent, 0)
                    firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, obj.Parent, 1)
                end
            end
        end
    end
end)

-- Infinity Jump
game:GetService("UserInputService").JumpRequest:Connect(function()
    if InfinityJumpEnabled then
        game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

local MainTab = Window:CreateTab("Main", 4483362458)

MainTab:CreateToggle({
   Name = "Speed Boost",
   CurrentValue = false,
   Callback = function(Value)
      SpeedBoostEnabled = Value
      if not Value then game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16 end
   end,
})

MainTab:CreateSlider({
   Name = "Speed Amount",
   Range = {16, 250},
   Increment = 1,
   CurrentValue = 50,
   Callback = function(Value) WalkSpeedValue = Value end,
})

MainTab:CreateToggle({
   Name = "Infinity Jump",
   CurrentValue = false,
   Callback = function(Value) InfinityJumpEnabled = Value end,
})

MainTab:CreateToggle({
   Name = "Auto Grab",
   CurrentValue = false,
   Callback = function(Value) AutoGrabEnabled = Value end,
})

task.spawn(function()
    while task.wait(0.1) do
        if SpeedBoostEnabled and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = WalkSpeedValue
        end
    end
end)
